# GrooveyAI Environment Configuration Template
# Copy this file to .env.local and add your keys.
# NEVER commit your real .env.local file to version control.

# -----------------------------------------------------------------------------
# Primary AI Provider: Google Gemini Developer API (Free Tier Supported)
# -----------------------------------------------------------------------------
# Required for primary coaching intelligence.
# Get a free key at: https://aistudio.google.com/
# Free-Tier Quota: 15 Requests Per Minute (RPM) / 1 Million Tokens Per Minute (TPM) / 1,500 Requests Per Day (RPD).
GEMINI_API_KEY="AIzaSy..."

# Optional: Override primary model (default is gemini-3.8-flash).
# Automatic fallbacks on transient 503/429 demand: gemini-3.7-flash, gemini-3.5-flash.
# GEMINI_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# Optional Secondary Free Fallback Providers (Only used when Gemini is at capacity)
# -----------------------------------------------------------------------------
# Optional Groq API Key (provides free-tier LLaMA 3.3 70B Versatile).
# Get a free key at: https://console.groq.com/
# Free-Tier Quota: 30 RPM / 14,400 Requests Per Day / 100k TPM.
# GROQ_API_KEY="gsk_..."

# Optional OpenRouter API Key (provides free-tier :free model fallback).
# Get a free key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-..."

# -----------------------------------------------------------------------------
# Application URL (Optional / Production Deployment)
# -----------------------------------------------------------------------------
# Used for absolute URL resolution, webhooks, or CORS headers.
# APP_URL="http://localhost:3000"
